# Vultr Serverless Inference (OpenAI-compatible). Get the key from the Vultr console:
# Products -> Serverless -> Inference -> your subscription -> API key.
VULTR_INFERENCE_API_KEY=
VULTR_INFERENCE_BASE_URL=https://api.vultrinference.com/v1

# Pick a model id from GET /api/ai/models (or https://api.vultrinference.com/v1/models).
VULTR_MODEL=llama-3.3-70b-instruct-fp8

# Where the SQLite file lives. Mount a volume here when deploying.
DATABASE_PATH=./data/udhaar.db

# Load the demo ledger on first start when the database is empty.
AUTO_SEED=true
